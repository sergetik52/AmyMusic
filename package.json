{
  "name": "amymusic1",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "electron:dev": "set AMYMUSIC_DEV=1&& electron .",
    "package:windows": "npm run build && electron-builder --win --x64",
    "release": "node scripts/release.cjs"
  },
  "build": {
    "appId": "com.amymusic.desktop",
    "productName": "AmyMusic",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "sergetik52",
      "repo": "AmyMusic"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AmyMusic-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "discord-rpc": "^4.0.1",
    "framer-motion": "^13.1.0",
    "hls.js": "^1.7.0",
    "https-proxy-agent": "^9.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.17.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
